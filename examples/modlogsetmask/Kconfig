#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_MODLOG_SETMASK
	tristate "\"module log set mask\" example"
	default n
	---help---
		Enable the \"module log set mask\" example

if EXAMPLES_MODLOG_SETMASK

config EXAMPLES_MODLOG_SETMASK_PROGNAME
	string "Program name"
	default "modsetmask"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config EXAMPLES_MODLOG_SETMASK_PRIORITY
	int "Hello task priority"
	default 100

config EXAMPLES_MODLOG_SETMASK_STACKSIZE
	int "Hello stack size"
	default DEFAULT_TASK_STACKSIZE

endif
